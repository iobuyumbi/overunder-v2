# copy this file to .env and fill in your OWN values.
# .env is gitignored -- never commit it, never paste it into chat.

# --- telegram (optional) -----------------------------------------------------
TELEGRAM_TOKEN=123456:abc-your-bot-token-from-botfather
TELEGRAM_CHAT_ID=@yourchannel
TELEGRAM_VIP_CHAT_ID=-1001234567890

# --- storage -----------------------------------------------------------------
OU_DATA_DIR=./data
OU_CACHE_DIR=~/.cache/overunder

# --- model thresholds ----------------------------------------------------------
# flat fallback gate (used when a market has no entry in MARKET_MIN_CONF)
O25_MIN_CONFIDENCE=0.55
# per-market entry gates -- a pick below its gate is never emitted
MARKET_MIN_CONF=over:0.85,btts:0.75,home:0.85,home_sc:0.85,away_sc:0.80,under:0.99,no_btts:0.99,over15:0.92,under35:0.90,home_dw:0.88
# global premium bar (markets not listed in MARKET_PREMIUM use this)
PREMIUM_TIER=0.85
# per-market premium bars -- btts/away_sc enter below 0.85, so they get their
# own fire threshold instead of never being able to reach Premium
MARKET_PREMIUM=btts:0.80,away_sc:0.83
# bump this whenever you change rules/gates/formula -- stale predict caches
# are keyed on it, so old-rule picks can never leak into new runs
OU_RULES_VERSION=2026-09-27.1
# per-category frequency thresholds (the numerators). Format per category:
#   CATEGORY=FULL_OUT_OF_6:SHORT_OUT_OF_3
# Categories:
#   scored    -- team actually scored a goal (attack evidence, H6/H7/A3/A8/A13)
#   conceded  -- team conceded a goal (defence-leakage, H8/A9/H12/A12)
#   over      -- over-X-line pattern, e.g. over/under 2.5 (H2, A4, H2u, A4u)
#   blank     -- team blanked / failed to score (no_btts, under: H6n, A3n, A8n, A18)
#   win       -- outright wins (home: H16)
#   cs        -- clean sheet / conceded zero (no_btts defence: H8n/H9n/A9n/A10n)
#   btts_game -- both teams scored in the same game (HB volatile home, AB volatile away)
#   nowin     -- team failed to win (drew or lost; away form: A16, A14, A15)
#
# DEFAULTS are now 4+/6 scored & conceded (relaxed, more picks). Three presets:
#
#  RELAXED 4/6 (DEFAULT, most picks, best for volume):
#   OU_FREQ=scored:4:2,conceded:4:2,over:4:2,blank:4:2,win:3:2,cs:5:3,btts_game:3:2,nowin:4:2
#
#  MEDIUM 5/6 (balanced, tighter signal, fewer false positives):
#   OU_FREQ=scored:5:3,conceded:5:3,over:4:2,blank:4:2,win:3:2,cs:5:3,btts_game:3:2,nowin:4:2
#
#  STRICT 6/6 (cleanest, fewest picks -- every match must show the pattern):
#OU_FREQ=scored:6:3,conceded:6:3,over:4:2,blank:4:2,win:3:2,cs:5:3,btts_game:3:2,nowin:4:2

# --- staking (hypothetical until real odds are wired in) -----------------------
DEFAULT_ODDS=2.0
KELLY_FRACTION=0.35
MAX_STAKE_PCT=0.3

# --- league health (caution where our patterns keep losing) --------------------
# trailing window + min sample before a league+market pair gets a caution tag
OU_LEAGUE_WINDOW_DAYS=30
OU_LEAGUE_MIN_PICKS=6
# picks are NEVER blocked -- cautioned picks carry a warning that our patterns
# don't suit the match. manual overrides, comma-separated league names:
# OU_LEAGUE_BLOCK=Europa League,Belarus League      -> always caution, all markets
# OU_LEAGUE_ALLOW=Scottish League Challenge Cup     -> never auto-caution
# OU_LEAGUE_AVOID_DISABLE=1                         -> turn the caution system off

# --- statarea cross-check ------------------------------------------------------
ST_OVER_MIN=70
ST_UNDER_MAX=40
ST_HOME_MIN=55
ST_MIN_MATCHES=30
FUZZY_MIN=0.78
# jina reader proxy 403s without a free key from jina.ai (direct fetch works
# without it -- this is only needed if your IP gets blocked by statarea)
# JINA_API_KEY=jina_xxxxxxxxxxxxxxxx

# --- cache tuning --------------------------------------------------------------
OU_HTML_TTL_TEAM=72        # hours; team history pages
OU_HTML_TTL_FIXTURE=6      # hours; fixture/date pages
OU_TEAM_CACHE_TTL=168      # hours; parsed team histories on disk
OU_PREDICT_CACHE_TTL=6     # hours; memoized predict_day results
# OU_CACHE_DISABLE=1       # bypass EVERY cache layer (settle/verify use this)
